# Local development. Copy this file to .env; the app loads it automatically.
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
ADMIN_USERNAME=admin
# Leave these blank for local development defaults only.
SECRET_KEY=
ADMIN_PASSWORD_HASH=
# Blank uses a fresh instance/admin.db SQLite database.
# For Supabase, paste the PostgreSQL Session pooler URI from Connect here.
# This is the database connection string, not the Supabase project URL/API key.
# Example format only (replace placeholders; URL-encode special password characters):
# postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=
# Remote PostgreSQL tables are not created automatically. Use check-db first.
# Run init-db explicitly only if this is a new database needing admin tables.
# Optional Supabase storage. Blank uses local instance/uploads instead.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=pod-uploads
# Optional shared request-limit storage (for example redis://localhost:6379/0).
RATELIMIT_STORAGE_URI=
